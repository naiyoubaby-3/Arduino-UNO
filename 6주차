#define RedLED   11 // RedLED라는 이름을 11번 핀으로 정의
#define GreenLED 5  // GreenLED라는 이름을 5번 핀으로 정의
#define BlueLED  3  // BlueLED라는 이름을 3번 핀으로 정의
#define BUTTON   2  // BUTTON이라는 이름을 2번 핀으로 정의

bool isRunning = false;        // RGB 반복 실행 여부를 저장하는 변수 (false: 정지, true: 실행)
bool lastButtonState = HIGH;   // 이전 루프에서의 버튼 상태 저장 (기본값: 안 눌림 = HIGH)

void setup() { // 아두이노 전원 입력 시 처음 1회 실행되는 초기화 함수
  pinMode(RedLED, OUTPUT);   // 11번(RedLED) 핀을 신호 출력 모드로 설정
  pinMode(GreenLED, OUTPUT); // 5번(GreenLED) 핀을 신호 출력 모드로 설정
  pinMode(BlueLED, OUTPUT);  // 3번(BlueLED) 핀을 신호 출력 모드로 설정
  
  pinMode(BUTTON, INPUT); // 2번(BUTTON) 핀을 내부 풀업 저항 입력 모드로 설정 (안 누르면 HIGH, 누르면 LOW)
} // setup() 함수 종료

void loop() { // setup() 실행 후 전원이 꺼질 때까지 무한 반복되는 메인 함수
  bool currentButtonState = digitalRead(BUTTON); // 현재 2번 핀의 버튼 전압 상태(HIGH 또는 LOW)를 읽어 변수에 저장

  // 이전 상태는 HIGH(안 눌림)이고, 현재 상태가 LOW(눌림)인 '버튼을 누른 순간'인지 확인
  if (lastButtonState == HIGH && currentButtonState == LOW) {
    isRunning = !isRunning;  // isRunning 상태를 반전시킴 (false면 true로, true면 false로 전환)
    
    // 동작을 정지시키는 상태(!isRunning)로 전환된 경우
    if (!isRunning) {
      analogWrite(RedLED, 0);   // Red LED 소등
      analogWrite(GreenLED, 0); // Green LED 소등
      analogWrite(BlueLED, 0);  // Blue LED 소등
    } // if (!isRunning) 종료
    
    delay(50); // 버튼 접점 진동(바운싱)으로 인한 신호 오류를 방지하기 위해 50ms(0.05초) 대기
  } // if (버튼 눌림 순간) 종료
  
  lastButtonState = currentButtonState; // 다음 루프 검사를 위해 현재 버튼 상태를 이전 상태 변수에 업데이트

  // isRunning 변수가 true(동작 중)일 때만 아래의 RGB LED Fade-in 제어 블록을 실행
  if (isRunning) {
    for (int i = 0; i < 3; i++) { // i가 0, 1, 2 순서대로 증가하며 LED 색상을 선택하는 루프 (0: Red, 1: Green, 2: Blue)
      for (int j = 0; j <= 255; j++) { // j가 0부터 255까지 1씩 증가하며 LED의 밝기를 제어하는 루프
        
        // 밝기가 올라가는 긴 지연시간 중간에 버튼이 눌렸는지 매 단계마다 즉시 확인
        if (digitalRead(BUTTON) == LOW) { // j 루프 실행 도중 버튼이 눌렸다면
          isRunning = false;      // 동작 상태를 false(정지)로 변경
          analogWrite(RedLED, 0);   // Red LED 소등
          analogWrite(GreenLED, 0); // Green LED 소등
          analogWrite(BlueLED, 0);  // Blue LED 소등
          delay(50);              // 바운싱 방지를 위해 50ms 대기
          break;                  // 현재 진행 중인 j 밝기 루프를 즉시 탈출
        } // if (중간 버튼 누름) 종료

        if (i == 0) analogWrite(RedLED, j);      // i가 0일 때 Red LED에 j 만큼의 밝기(PWM) 출력
        else if (i == 1) analogWrite(GreenLED, j); // i가 1일 때 Green LED에 j 만큼의 밝기(PWM) 출력
        else if (i == 2) analogWrite(BlueLED, j);  // i가 2일 때 Blue LED에 j 만큼의 밝기(PWM) 출력
        
        delay(10); // 밝기가 1단계 상승할 때마다 10ms 동안 대기 (전체 밝기 증가에 약 2.5초 소요)
      } // 밝기(j) 루프 종료
      
      // 한 가지 색상의 Fade-in이 끝나면 다음 색상으로 넘어가기 전 모든 LED를 잠시 소등
      analogWrite(RedLED, 0);   // Red LED 소등
      analogWrite(GreenLED, 0); // Green LED 소등
      analogWrite(BlueLED, 0);  // Blue LED 소등

      if (!isRunning) break; // 중간에 정지 명령이 내려졌다면 outer 색상(i) 루프도 즉시 탈출
    } // 색상(i) 루프 종료
  } // if (isRunning) 종료
} // loop() 함수 종료